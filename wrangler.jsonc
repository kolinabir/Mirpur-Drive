// Cloudflare Workers static-assets deploy: `npm run build` then
// `npx wrangler deploy` uploads dist/ as-is. No Worker script, no bindings —
// the game is a fully static site. Cache rules live in public/_headers.
{
  "name": "mirpur-drive",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist"
  }
}
